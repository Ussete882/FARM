{
  "name": "bastet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BASTET - Sistema Operativo de Gestao da LHF-Foundation.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bastet/web",
    "dev:api": "npm run dev --workspace @bastet/api",
    "build": "npm run build --workspace @bastet/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bd:subir": "docker compose --file infra/docker-compose.yml up --detach",
    "bd:descer": "docker compose --file infra/docker-compose.yml down",
    "bd:migrar": "npm run migrar --workspace @bastet/api"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.5"
  }
}
